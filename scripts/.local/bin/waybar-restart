#!/usr/bin/env bash
W="$HOME/dotfiles/waybar/.config/waybar"
A="$HOME/.local/bin/appearance"
"$HOME/.local/bin/waybar-build" || exit 1
pkill -f '[b]ar-autohide'
pkill -f '[w]orkspace-pill daemon'
pkill -x waybar
sleep 0.3
setsid nohup waybar -c "$HOME/.cache/waybar/config.json" -s "$W/style.css" >/dev/null 2>&1 &
if [ "$("$A" get bar_autohide off 2>/dev/null || echo off)" = on ]; then
  setsid nohup "$HOME/.local/bin/bar-autohide" >/dev/null 2>&1 &
fi
setsid nohup "$HOME/.local/bin/workspace-pill" daemon >/dev/null 2>&1 &
