#!/usr/bin/env bash
set -euo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
CACHE="$RUNTIME/waybar-workspaces.json"
TMP="$CACHE.tmp"
LAST=""
SOCAT_PID=""
DEFAULT_GLYPH="󰀻"

declare -A GLYPHS=(
  [kitty]="󰆍"
  [Alacritty]="󰆍"
  [brave-browser]="󰖟"
  [firefox]="󰈹"
  [org.kde.dolphin]="󰉋"
  [org.kde.kate]="󰈙"
  [code]="󰨞"
  [code-oss]="󰨞"
  [spotify]="󰓇"
  [discord]="󰙯"
)

state_json() {
  local active clients
  active=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty') || return 1
  clients=$(hyprctl clients -j 2>/dev/null) || return 1
  jq -cn --argjson active "${active:-0}" --argjson clients "$clients" \
    '{active:$active, clients:$clients}'
}

render() {
  local ws="$1" data active client class title glyph text cls tooltip
  if [ -s "$CACHE" ]; then
    data=$(<"$CACHE")
  else
    data=$(state_json) || exit 0
  fi

  active=$(jq -r '.active // 0' <<<"$data")
  client=$(jq -c --argjson ws "$ws" '
    [.clients[] | select(.workspace.id == $ws and .mapped == true and (.hidden != true))]
    | sort_by(.focusHistoryID)
    | .[0] // empty
  ' <<<"$data")

  cls=""
  if [ "$active" = "$ws" ]; then
    cls="active"
  fi

  if [ -z "$client" ]; then
    text="$ws"
    cls="${cls:+$cls }empty"
    tooltip="Workspace $ws · vacío"
  else
    class=$(jq -r '.class // ""' <<<"$client")
    title=$(jq -r '.title // ""' <<<"$client")
    glyph=${GLYPHS[$class]:-$DEFAULT_GLYPH}
    text="$glyph"
    cls="${cls:+$cls }occupied"
    tooltip="Workspace $ws · ${class:-app} — $title"
  fi

  jq -cn --arg text "$text" --arg tooltip "$tooltip" --arg class "$cls" \
    '{text:$text, tooltip:$tooltip, class:($class | split(" ") | map(select(length > 0)))}'
}

click() {
  local ws="$1" active clients current idx next
  active=$(hyprctl activeworkspace -j | jq -r '.id')

  if [ "$ws" != "$active" ]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = $ws })" >/dev/null
    return 0
  fi

  clients=$(hyprctl clients -j)
  current=$(hyprctl activewindow -j | jq -r '.address // empty')
  local -a addrs=()
  mapfile -t addrs < <(
    jq -r --argjson ws "$ws" '
      .[] | select(.workspace.id == $ws and .mapped == true and (.hidden != true))
      | [.focusHistoryID, .address] | @tsv
    ' <<<"$clients" | sort -n -k1,1 | cut -f2
  )

  [ "${#addrs[@]}" -gt 1 ] || return 0

  idx=-1
  for i in "${!addrs[@]}"; do
    if [ "${addrs[$i]}" = "$current" ]; then
      idx=$i
      break
    fi
  done

  if [ "$idx" -lt 0 ]; then
    next="${addrs[0]}"
  else
    next="${addrs[$(((idx + 1) % ${#addrs[@]}))]}"
  fi

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$next\" })" >/dev/null
}

refresh() {
  local data
  data=$(state_json) || return 1
  if [ "$data" != "$LAST" ]; then
    printf '%s\n' "$data" >"$TMP"
    mv "$TMP" "$CACHE"
    LAST="$data"
    pkill -SIGRTMIN+8 -x waybar 2>/dev/null || true
  fi
}

hypr_socket() {
  local dir="$RUNTIME/hypr" sig="${HYPRLAND_INSTANCE_SIGNATURE:-}" socket
  if [ -n "$sig" ] && [ -S "$dir/$sig/.socket2.sock" ]; then
    printf '%s\n' "$dir/$sig/.socket2.sock"
    return 0
  fi
  socket=$(find "$dir" -mindepth 2 -maxdepth 2 -type s -name .socket2.sock \
    -print -quit 2>/dev/null || true)
  [ -n "$socket" ] && printf '%s\n' "$socket"
}

poll_daemon() {
  while :; do
    refresh || sleep 0.5
    sleep 1
  done
}

cleanup() {
  rm -f "$TMP"
  if [ -n "${SOCAT_PID:-}" ]; then
    kill "$SOCAT_PID" 2>/dev/null || true
    wait "$SOCAT_PID" 2>/dev/null || true
  fi
}

event_daemon() {
  local socket event kind
  while :; do
    refresh || true
    socket=$(hypr_socket) || true
    if [ -z "$socket" ]; then
      sleep 1
      continue
    fi

    coproc SOCAT { exec socat -u "UNIX-CONNECT:$socket" - 2>/dev/null; }
    while IFS= read -r -u "${SOCAT[0]}" event; do
      kind=${event%%>>*}
      case "$kind" in
        workspace|focusedmon|activespecial|createworkspace|destroyworkspace|renameworkspace|moveworkspace|moveworkspacetomonitor|openwindow|closewindow|movewindow|movewindowv2|activewindow|windowtitle|windowtitlev2|urgent|changefloatingmode|fullscreen|pin|togglegroup|moveintogroup|moveoutofgroup|lockgroups|configreloaded|monitoradded|monitorremoved|monitoraddedv2)
          refresh || true
          ;;
      esac
    done

    kill "$SOCAT_PID" 2>/dev/null || true
    wait "$SOCAT_PID" 2>/dev/null || true
    SOCAT_PID=""
    sleep 1
  done
}

daemon() {
  trap cleanup EXIT
  trap 'exit 0' TERM INT
  LAST=""
  if command -v socat >/dev/null 2>&1; then
    event_daemon
  else
    poll_daemon
  fi
}

case "${1:-}" in
  render)
    render "${2:?workspace requerido}"
    ;;
  click)
    click "${2:?workspace requerido}"
    ;;
  daemon)
    daemon
    ;;
  *)
    printf 'uso: %s {render|click} <workspace> | daemon\n' "$0" >&2
    exit 1
    ;;
esac
