#!/usr/bin/env bash
CFG="$HOME/dotfiles/rofi/.config/rofi/power.rasi"
KB=(-kb-move-char-back "Control+b" -kb-move-char-forward "Control+f"
    -kb-row-left "Left,Control+Page_Up" -kb-row-right "Right,Control+Page_Down"
    -kb-cancel "Escape,BackSpace,Control+g" -kb-remove-char-back "Control+h")

# --- Íconos propios, mismo estilo, color según el tema ---
COLOR="#f5f5f7"
[ "$(cat "$HOME/.config/theme/mode" 2>/dev/null)" = light ] && COLOR="#1d1d1f"
IDIR="$HOME/.cache/power-menu-icons"
mkdir -p "$IDIR"

svg() {
  printf '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%s" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">%s</svg>\n' \
    "$COLOR" "$2" > "$IDIR/$1.svg"
}
svg lock      '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'
svg logout    '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>'
svg suspend   '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>'
svg hibernate '<path d="M2 12h20"/><path d="M12 2v20"/><path d="m20 16-4-4 4-4"/><path d="m4 8 4 4-4 4"/><path d="m16 4-4 4-4-4"/><path d="m8 20 4-4 4 4"/>'
svg reboot    '<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>'
svg poweroff  '<path d="M12 2v10"/><path d="M18.4 6.6a9 9 0 1 1-12.77.04"/>'

mk() { printf '%s\0icon\x1f%s\n' "$1" "$IDIR/$2.svg"; }

idx=$({ mk Bloquear lock
        mk "Cerrar sesión" logout
        mk Suspender suspend
        mk Hibernar hibernate
        mk Reiniciar reboot
        mk Apagar poweroff; } \
  | rofi -dmenu -no-custom -format i -show-icons \
      -mesg "Elige una opción · tendrás 3 s para cancelar con Esc o Retroceso" \
      -config "$CFG" "${KB[@]}") || exit 0

names=(lock logout suspend hibernate reboot poweroff)
labels=("Bloqueando" "Cerrando sesión" "Suspendiendo" "Hibernando" "Reiniciando" "Apagando")
action=${names[$idx]}

if [ "$action" != lock ]; then
  timeout 3 rofi -dmenu -no-custom -config "$CFG" "${KB[@]}" \
    -mesg "${labels[$idx]} en 3 segundos…"$'\n'"Esc o Retroceso para cancelar" \
    -theme-str 'window { width: 460px; } mainbox { children: [ "message" ]; } textbox { horizontal-align: 0.5; font: "Inter Bold 13"; text-color: @text; }' \
    < /dev/null
  [ $? -eq 124 ] || exit 0
fi

case "$action" in
  lock)      "$HOME/.local/bin/lock-screen" ;;
  logout)    hyprctl dispatch exit ;;
  suspend)   systemctl suspend ;;
  hibernate) systemctl hibernate ;;
  reboot)    systemctl reboot ;;
  poweroff)  systemctl poweroff ;;
esac
