#!/usr/bin/env python3
"""
Glasshouse power menu (Wayland/Hyprland, gtk-layer-shell).
Full-screen "liquid glass" overlay inspired by the iOS power-off screen.

DRY-RUN MODE (default): actions are printed with echo instead of executed.
Set DRY_RUN = False (see "Customization" below) after verifying the menu.
"""

# -----------------------------------------------------------------------------
# Customization (edit these values to tune look and behavior)
# -----------------------------------------------------------------------------
DRY_RUN = False  # True = print commands with `echo` (safe). False = run them.

# Glass / overlay (geometry). Colors adapt to system light/dark mode at runtime.
PILL_WIDTH = 360
PILL_HEIGHT = 68
PILL_RADIUS = 34
PILL_GAP = 15
BADGE_SIZE = 44

# Accents (icon badge)
ACCENT_SHUTDOWN = "#ff6b4a"  # red/orange
ACCENT_REBOOT = "#4da3ff"    # blue

# Text / fonts
TITLE_SIZE_PX = 28
SUBTITLE_SIZE_PX = 14
LABEL_SIZE_PX = 16
CANCEL_LABEL_SIZE_PX = 13
FONT_FAMILY = "Inter, 'SF Pro Display', 'SF Pro Text', sans-serif"

# Animation (milliseconds)
FADE_MS = 180
SLIDE_PX = 18
HOVER_TRANSITION_MS = 140

# Close/toggle
LAYER_NAMESPACE = "powermenu"  # used by Hyprland layerrules
# -----------------------------------------------------------------------------

import locale
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

HOME = Path.home()
THEME_MODE_FILE = HOME / ".config/theme/mode"


def is_light_mode() -> bool:
    try:
        return THEME_MODE_FILE.read_text(encoding="utf-8", errors="ignore").strip().lower() == "light"
    except Exception:
        return False


def accent_neutral() -> str:
    # Neutral badge: subtle contrast in both modes
    return "rgba(0,0,0,0.10)" if is_light_mode() else "rgba(255,255,255,0.18)"


# -----------------------------------------------------------------------------
# Localization: choose strings from system locale (LC_MESSAGES/LANG)
# -----------------------------------------------------------------------------
def detect_lang() -> str:
    lang = (
        os.environ.get("LC_ALL")
        or os.environ.get("LC_MESSAGES")
        or os.environ.get("LANG")
        or ""
    )
    try:
        loc = locale.getlocale()[0] or locale.getdefaultlocale()[0] or ""
    except Exception:
        loc = ""
    code = (lang or loc or "").lower()
    if code.startswith("es"):
        return "es"
    if code.startswith("pt"):
        return "pt"
    return "en"


STRINGS = {
    "en": {
        "title": "Power Menu",
        "subtitle": "Choose an action",
        "lock": "Lock",
        "logout": "Logout",
        "sleep": "Sleep",
        "hibernate": "Hibernate",
        "reboot": "Reboot",
        "shutdown": "Shutdown",
        "cancel": "Cancel",
    },
    "es": {
        "title": "Menú de energía",
        "subtitle": "Elige una acción",
        "lock": "Bloquear",
        "logout": "Cerrar sesión",
        "sleep": "Suspender",
        "hibernate": "Hibernar",
        "reboot": "Reiniciar",
        "shutdown": "Apagar",
        "cancel": "Cancelar",
    },
    "pt": {
        "title": "Menu de energia",
        "subtitle": "Escolha uma ação",
        "lock": "Bloquear",
        "logout": "Sair",
        "sleep": "Suspender",
        "hibernate": "Hibernar",
        "reboot": "Reiniciar",
        "shutdown": "Desligar",
        "cancel": "Cancelar",
    },
}
L = STRINGS[detect_lang()]


# -----------------------------------------------------------------------------
# Actions: each entry is (id, icon, label, command_argv, accent, destructive)
# destructive = True for Shutdown/Reboot/Logout (run immediately on confirm).
# Commands are argv lists; DRY_RUN prints them via `echo` instead of running.
# Hibernate is intentionally omitted: on this setup there is no suitable
# disk-backed swap/resume configuration, so the option is suppressed.
# -----------------------------------------------------------------------------
def build_actions():
    neutral = accent_neutral()
    actions = [
        ("lock", "", L["lock"], ["loginctl", "lock-session"], neutral, False),
        # Hyprland 0.57+ (Lua config) rejects `hyprctl dispatch exit`; try the new
        # dispatcher form and fall back to loginctl for other/older setups.
        ("logout", "󰍃", L["logout"], ["sh", "-c", 'hyprctl dispatch exit 2>/dev/null || hyprctl dispatch "hl.dsp.exit()" 2>/dev/null || loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null || loginctl kill-session "${XDG_SESSION_ID:-}"'], neutral, True),
        ("sleep", "󰤄", L["sleep"], ["systemctl", "suspend"], neutral, False),
    ]
    actions.extend(
        [
            ("reboot", "󰜉", L["reboot"], ["systemctl", "reboot"], ACCENT_REBOOT, True),
            ("shutdown", "⏻", L["shutdown"], ["systemctl", "poweroff"], ACCENT_SHUTDOWN, True),
        ]
    )
    return actions


def run_action(argv):
    """Run (or echo) a command without blocking the UI."""
    try:
        if DRY_RUN:
            # Dry run: show the command so you can verify without powering off.
            cmd_str = " ".join(argv)
            print(f"[dry-run] echo {cmd_str}", flush=True)
            subprocess.Popen(["echo", cmd_str], start_new_session=True)
        else:
            subprocess.Popen(argv, start_new_session=True)
    except Exception as e:
        print(f"power-menu: failed to run {argv}: {e}", file=sys.stderr)


# -----------------------------------------------------------------------------
# CSS: "liquid glass" styling. Hyprland provides the blur via layerrule;
# this stylesheet provides tint, translucency, borders, highlights and motion.
# -----------------------------------------------------------------------------
def _theme_colors():
    """Read Glasshouse theme tokens from current.css for consistent glass tones."""
    css = HOME / ".config/theme/current.css"
    colors = {}
    try:
        for m in re.finditer(r"@define-color\s+(\S+)\s+([^;]+);", css.read_text(encoding="utf-8")):
            colors[m.group(1)] = m.group(2).strip()
    except Exception:
        pass
    return colors


def load_css():
    light = is_light_mode()
    try:
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", not light)
    except Exception:
        pass
    tc = _theme_colors()

    if light:
        # Light mode: align with Glasshouse glass tokens (strong contrast)
        overlay_tint = "rgba(255, 255, 255, 0.22)"
        pill_bg = "rgba(255, 255, 255, 0.78)"
        pill_bg_hover = "rgba(255, 255, 255, 0.92)"
        pill_border = tc.get("border", "rgba(0, 0, 0, 0.10)")
        pill_highlight = "rgba(255, 255, 255, 0.55)"
        text_primary = tc.get("text", "#1d1d1f")
        text_secondary = tc.get("text", "#1d1d1f")  # strong contrast on overlay
        text_cancel = text_primary
        hover_border = "rgba(0, 0, 0, 0.18)"
        title_shadow = "0 1px 3px rgba(255,255,255,0.55), 0 0 8px rgba(255,255,255,0.35)"
        badge_icon = "#1d1d1f"
        x_bg = pill_bg
        x_bg_hover = pill_bg_hover
    else:
        # Dark mode: match Glasshouse settings-menu glass (rows = @surface on @bg)
        overlay_tint = "rgba(0, 0, 0, 0.35)"
        # Approximate @surface (rgba(255,255,255,0.08)) over @bg (rgba(30,30,34,0.60))
        pill_bg = "rgba(50, 50, 56, 0.78)"
        pill_bg_hover = "rgba(60, 60, 67, 0.86)"
        pill_border = tc.get("border", "rgba(255, 255, 255, 0.14)")
        pill_highlight = "rgba(255, 255, 255, 0.05)"
        text_primary = tc.get("text", "#f5f5f7")
        text_secondary = tc.get("subtext", "#a1a1a6")
        text_cancel = tc.get("subtext", "#a1a1a6")
        hover_border = "rgba(255, 255, 255, 0.22)"
        title_shadow = "0 1px 3px rgba(0,0,0,0.70), 0 0 10px rgba(0,0,0,0.45)"
        badge_icon = tc.get("text", "#f5f5f7")
        x_bg = pill_bg
        x_bg_hover = pill_bg_hover

    css = f"""
    * {{
        font-family: {FONT_FAMILY};
    }}
    window, .pm-window {{
        background-color: {overlay_tint};
    }}
    .pm-title {{
        color: {text_primary};
        font-size: {TITLE_SIZE_PX}px;
        font-weight: 600;
        text-shadow: {title_shadow};
    }}
    .pm-subtitle {{
        color: {text_secondary};
        font-size: {SUBTITLE_SIZE_PX}px;
        font-weight: 500;
        text-shadow: {title_shadow};
    }}
    .pm-pill {{
        background-color: {pill_bg};
        background-image: linear-gradient(to bottom, {pill_highlight}, rgba(255,255,255,0));
        border: 1px solid {pill_border};
        border-radius: {PILL_RADIUS}px;
        min-width: {PILL_WIDTH}px;
        min-height: {PILL_HEIGHT}px;
        padding: 0 18px;
        transition: all {HOVER_TRANSITION_MS}ms ease;
    }}
    .pm-pill:hover, .pm-pill:focus {{
        background-color: {pill_bg_hover};
        border-color: {hover_border};
        outline: none;
    }}
    .pm-badge {{
        min-width: {BADGE_SIZE}px;
        min-height: {BADGE_SIZE}px;
        border-radius: {BADGE_SIZE // 2}px;
        color: {badge_icon};
        font-size: 18px;
    }}
    .pm-label {{
        color: {text_primary};
        font-size: {LABEL_SIZE_PX}px;
        font-weight: 500;
    }}
    .pm-x {{
        background-color: {x_bg};
        border: 1px solid {pill_border};
        border-radius: 28px;
        min-width: 56px;
        min-height: 56px;
        color: {text_primary};
        font-size: 22px;
        transition: all {HOVER_TRANSITION_MS}ms ease;
    }}
    .pm-x:hover, .pm-x:focus {{
        background-color: {x_bg_hover};
        outline: none;
    }}
    .pm-cancel {{
        color: {text_cancel};
        font-size: {CANCEL_LABEL_SIZE_PX}px;
    }}
    button {{
        box-shadow: none;
    }}
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode("utf-8"))
    screen = Gdk.Screen.get_default()
    if screen:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )


class PowerMenuWindow(Gtk.Window):
    """Full-screen layer-shell overlay window."""

    def __init__(self, app):
        super().__init__(application=app)
        self.app = app
        self.actions = build_actions()
        self.pill_buttons = []
        self.focus_index = 0
        self.closing = False

        # --- Layer-shell: full-screen overlay with keyboard focus, namespace for blur ---
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, LAYER_NAMESPACE)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        GtkLayerShell.set_exclusive_zone(self, -1)
        for edge in (
            GtkLayerShell.Edge.TOP,
            GtkLayerShell.Edge.BOTTOM,
            GtkLayerShell.Edge.LEFT,
            GtkLayerShell.Edge.RIGHT,
        ):
            GtkLayerShell.set_anchor(self, edge, True)

        self.set_decorated(False)
        self.set_app_paintable(True)
        self.get_style_context().add_class("pm-window")

        # Root event box: clicking the background (outside pills) cancels/closes.
        self.root = Gtk.EventBox()
        self.root.set_visible_window(False)
        self.root.set_above_child(False)
        self.root.connect("button-press-event", self.on_background_click)
        self.add(self.root)

        # Centered content column
        self.outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.outer.set_halign(Gtk.Align.CENTER)
        self.outer.set_valign(Gtk.Align.CENTER)
        self.root.add(self.outer)

        # Title + subtitle
        title = Gtk.Label(label=L["title"])
        title.get_style_context().add_class("pm-title")
        subtitle = Gtk.Label(label=L["subtitle"])
        subtitle.get_style_context().add_class("pm-subtitle")
        subtitle.set_margin_bottom(28)
        self.outer.pack_start(title, False, False, 4)
        self.outer.pack_start(subtitle, False, False, 0)

        # Vertical stack of pill buttons
        self.stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=PILL_GAP)
        self.stack.set_halign(Gtk.Align.CENTER)
        self.outer.pack_start(self.stack, False, False, 0)

        for idx, (aid, icon, label, argv, accent, destructive) in enumerate(self.actions):
            btn = self.make_pill(idx, icon, label, accent)
            btn.connect("clicked", self.on_pill_clicked, idx)
            self.stack.pack_start(btn, False, False, 0)
            self.pill_buttons.append(btn)

        # Circular X cancel button + label
        x_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        x_box.set_halign(Gtk.Align.CENTER)
        x_box.set_margin_top(28)
        self.x_btn = Gtk.Button(label="✕")
        self.x_btn.get_style_context().add_class("pm-x")
        self.x_btn.set_relief(Gtk.ReliefStyle.NONE)
        self.x_btn.set_size_request(56, 56)
        self.x_btn.connect("clicked", lambda *_: self.close_menu(run_cmd=None))
        x_box.pack_start(self.x_btn, False, False, 0)
        cancel_lbl = Gtk.Label(label=L["cancel"])
        cancel_lbl.get_style_context().add_class("pm-cancel")
        x_box.pack_start(cancel_lbl, False, False, 0)
        self.outer.pack_start(x_box, False, False, 0)

        # Keyboard handling: Esc cancels, arrows/tab move, Enter activates, 1-6 shortcuts
        self.connect("key-press-event", self.on_key)

        # Open animation: fade in + slight slide up
        self.set_opacity(0.0)
        self.outer.set_margin_top(SLIDE_PX)
        self.show_all()
        if self.pill_buttons:
            self.pill_buttons[0].grab_focus()
        self.animate_open()

    # --- Pill construction (badge + label) ---
    def make_pill(self, idx, icon, text, accent):
        btn = Gtk.Button()
        btn.get_style_context().add_class("pm-pill")
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.set_can_focus(True)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        row.set_halign(Gtk.Align.START)
        row.set_valign(Gtk.Align.CENTER)

        badge = Gtk.Label(label=icon)
        badge.get_style_context().add_class("pm-badge")
        badge.set_size_request(BADGE_SIZE, BADGE_SIZE)
        badge.set_halign(Gtk.Align.CENTER)
        badge.set_valign(Gtk.Align.CENTER)
        # Per-badge accent color via inline CSS provider
        bprov = Gtk.CssProvider()
        _bcolor = "#ffffff" if accent in (ACCENT_SHUTDOWN, ACCENT_REBOOT) else ("#1d1d1f" if is_light_mode() else "#f5f5f7")
        bprov.load_from_data(f"* {{ background-color: {accent}; color: {_bcolor}; }}".encode("utf-8"))
        badge.get_style_context().add_provider(bprov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        lbl = Gtk.Label(label=text)
        lbl.get_style_context().add_class("pm-label")
        lbl.set_halign(Gtk.Align.START)

        row.pack_start(badge, False, False, 0)
        row.pack_start(lbl, False, False, 0)
        btn.add(row)
        return btn

    # --- Background click: cancel if click is outside interactive controls ---
    def on_background_click(self, widget, event):
        # If click target is not inside a pill or the X button, close.
        child = self.get_child_at_pos(int(event.x), int(event.y)) if hasattr(self, "get_child_at_pos") else None
        # Simpler: walk allocation of stack/x_box; if outside, close.
        x, y = event.x, event.y
        for w in self.pill_buttons + [self.x_btn]:
            ok, wx, wy = w.translate_coordinates(self, 0, 0)
            if not ok:
                continue
            alloc = w.get_allocation()
            if wx <= x <= wx + alloc.width and wy <= y <= wy + alloc.height:
                return False
        self.close_menu(run_cmd=None)
        return True

    # --- Input handling ---
    def on_key(self, widget, event):
        key = Gdk.keyval_name(event.keyval)
        if key in ("Escape",):
            self.close_menu(run_cmd=None)
            return True
        if key in ("Up", "ISO_Left_Tab"):
            self.move_focus(-1)
            return True
        if key in ("Down", "Tab"):
            self.move_focus(1)
            return True
        if key in ("Return", "KP_Enter", "space"):
            focused = self.get_focus()
            if focused is self.x_btn:
                self.close_menu(run_cmd=None)
            else:
                for i, btn in enumerate(self.pill_buttons):
                    if focused is btn or (focused and focused.is_ancestor(btn)):
                        self.activate_index(i)
                        break
                else:
                    self.activate_index(self.focus_index)
            return True
        # Number shortcuts 1-6
        if key and len(key) == 1 and key.isdigit():
            n = int(key)
            if 1 <= n <= len(self.pill_buttons):
                self.activate_index(n - 1)
                return True
        return False

    def move_focus(self, delta):
        if not self.pill_buttons:
            return
        self.focus_index = (self.focus_index + delta) % len(self.pill_buttons)
        self.pill_buttons[self.focus_index].grab_focus()

    def on_pill_clicked(self, _btn, idx):
        self.activate_index(idx)

    def activate_index(self, idx):
        if idx < 0 or idx >= len(self.actions):
            return
        _aid, _icon, _label, argv, _accent, _destructive = self.actions[idx]
        # Destructive actions (Shutdown/Reboot/Logout) run immediately on confirm
        # (click/Enter). Non-destructive run the same way here (no extra screen).
        self.close_menu(run_cmd=argv)

    # --- Open/close animations (fade + slight slide) ---
    def animate_open(self):
        start = GLib.get_monotonic_time()
        duration = FADE_MS * 1000

        def step():
            if self.closing:
                return False
            elapsed = GLib.get_monotonic_time() - start
            t = min(1.0, elapsed / duration) if duration else 1.0
            # ease-out
            e = 1 - (1 - t) * (1 - t)
            self.set_opacity(e)
            self.outer.set_margin_top(int(SLIDE_PX * (1 - e)))
            return t < 1.0

        GLib.timeout_add(16, step)

    def close_menu(self, run_cmd=None):
        if self.closing:
            return
        self.closing = True
        start = GLib.get_monotonic_time()
        duration = int(FADE_MS * 1000 * 0.85)
        start_opacity = self.get_opacity()

        def finish():
            self.destroy()
            if run_cmd:
                run_action(run_cmd)
            return False

        def step():
            elapsed = GLib.get_monotonic_time() - start
            t = min(1.0, elapsed / duration) if duration else 1.0
            e = 1 - (1 - t) * (1 - t)
            self.set_opacity(max(0.0, start_opacity * (1 - e)))
            self.outer.set_margin_top(int(SLIDE_PX * e))
            if t >= 1.0:
                finish()
                return False
            return True

        GLib.timeout_add(16, step)


class PowerMenuApp(Gtk.Application):
    """Single-instance app: launching again while open toggles (closes) it."""

    def __init__(self):
        super().__init__(application_id="glasshouse.powermenu")
        self.win = None

    def do_activate(self):
        # Toggle: if a window is already open, close it.
        if self.win and self.win.get_visible():
            self.win.close_menu(run_cmd=None)
            return
        self.win = PowerMenuWindow(self)
        self.win.present()


def main():
    load_css()
    app = PowerMenuApp()
    app.run(sys.argv)


if __name__ == "__main__":
    main()
