#!/usr/bin/env bash
# Dock: ordenar, quitar y añadir las apps ancladas (nwg-dock-hyprland).
F="${DOCK_PINNED:-$HOME/.cache/nwg-dock-pinned}"
CFG="${ROFI_CFG:-$HOME/dotfiles/rofi/.config/rofi/config.rasi}"
RESTART="${DOCK_RESTART:-$HOME/.local/bin/dock-restart}"
APPDIRS=(/usr/share/applications "$HOME/.local/share/applications")

R() { rofi -dmenu -i -no-custom -format i -config "$CFG" "$@"; }
mkdir -p "$(dirname "$F")"; touch "$F"
dirty=0

desktop_file() {   # id -> ruta del .desktop
  local d; for d in "${APPDIRS[@]}"; do [ -f "$d/$1.desktop" ] && { echo "$d/$1.desktop"; return; }; done
}
app_name() {
  local f; f="$(desktop_file "$1")"
  if [ -n "$f" ]; then grep -m1 '^Name=' "$f" | cut -d= -f2-; else echo "$1"; fi
}
load()  { mapfile -t APPS < <(grep -v '^[[:space:]]*$' "$F"); }
store() { printf '%s\n' "${APPS[@]}" > "$F"; dirty=1; }

add_app() {
  local ids=() names=() icons=() d f id name icon sel
  for d in "${APPDIRS[@]}"; do
    for f in "$d"/*.desktop; do
      [ -f "$f" ] || continue
      grep -q '^NoDisplay=true' "$f" && continue
      name="$(grep -m1 '^Name=' "$f" | cut -d= -f2-)"; [ -n "$name" ] || continue
      icon="$(grep -m1 '^Icon=' "$f" | cut -d= -f2-)"
      ids+=("$(basename "$f" .desktop)"); names+=("$name"); icons+=("$icon")
    done
  done
  [ "${#ids[@]}" -gt 0 ] || return 0
  sel=$(for i in "${!ids[@]}"; do printf '%s\0icon\x1f%s\n' "${names[$i]}" "${icons[$i]}"; done \
        | R -show-icons -p "Añadir al dock" -theme-str 'listview { lines: 10; }') || return 0
  id="${ids[$sel]}"
  for a in "${APPS[@]}"; do [ "$a" = "$id" ] && return 0; done
  APPS+=("$id"); store
}

app_menu() {
  local i="$1" id a n
  id="${APPS[$i]}"
  while true; do
    n="${#APPS[@]}"
    a=$(printf '%s\n' "Subir (hacia la izquierda)" "Bajar (hacia la derecha)" "Al principio" "Al final" \
          "Quitar del dock" "Listo" | R -p "$(app_name "$id")" -mesg "Posición $((i+1)) de $n") || return 0
    case "$a" in
      0) [ "$i" -gt 0 ] && { local t="${APPS[$i-1]}"; APPS[$i-1]="${APPS[$i]}"; APPS[$i]="$t"; i=$((i-1)); store; } ;;
      1) [ "$i" -lt $((n-1)) ] && { local t="${APPS[$i+1]}"; APPS[$i+1]="${APPS[$i]}"; APPS[$i]="$t"; i=$((i+1)); store; } ;;
      2) APPS=("$id" "${APPS[@]:0:$i}" "${APPS[@]:$((i+1))}"); i=0; store ;;
      3) APPS=("${APPS[@]:0:$i}" "${APPS[@]:$((i+1))}" "$id"); i=$((${#APPS[@]}-1)); store ;;
      4) APPS=("${APPS[@]:0:$i}" "${APPS[@]:$((i+1))}"); store; return 0 ;;
      *) return 0 ;;
    esac
  done
}

sel=0
while true; do
  load
  lines=()
  for i in "${!APPS[@]}"; do lines+=("$(printf '%2d  %s' "$((i+1))" "$(app_name "${APPS[$i]}")")"); done
  lines+=("＋  Añadir una app…")
  idx=$(printf '%s\n' "${lines[@]}" \
        | R -p "Dock" -selected-row "$sel" -mesg "Apps ancladas · Esc para salir y aplicar" \
            -theme-str 'listview { lines: 10; }') || break
  if [ "$idx" -ge "${#APPS[@]}" ]; then add_app; sel=0; else app_menu "$idx"; sel=$idx; fi
done

[ "$dirty" = 1 ] && "$RESTART"
exit 0
