# Language & Input: the only privileged component is this helper.  The menu
# itself stays unprivileged and calls it through pkexec/sudo (polkit rule
# 90-localeinput.rules).  The repo path is a development fallback, exactly like
# powermodemenu.py does.
LOCALE_HELPER_INSTALLED = Path("/usr/local/lib/localeinput/locale-input-helper")
LOCALE_HELPER_REPO = REPO / "scripts/.local/lib/localeinput/locale-input-helper"
EVDEV_LST = Path("/usr/share/X11/xkb/rules/evdev.lst")
SUPPORTED_LOCALES = Path("/usr/share/i18n/SUPPORTED")
LOCALE_GEN = Path("/etc/locale.gen")
USERPREFS_CONF = HOME / ".config/hypr/userprefs.conf"
USERPREFS_LUA = HOME / ".config/hypr/userprefs.lua"
DRY_RUN = os.environ.get("LOCALEINPUT_DRY_RUN", "") == "1"

INTERVALS = ["5", "10", "15", "30", "60"]

# Translation strategy: one dictionary in this file, keyed by the Spanish
# string that already exists in the menu.  The menu is a single script with no
# gettext domain or .mo catalog, so a dictionary is the smallest approach that
# keeps every string in one place and needs no build step.  If the interface
# language is English, tr() looks the Spanish text up; otherwise it returns the
# Spanish text unchanged.
def interface_language():
    value = (
        os.environ.get("LC_ALL")
        or os.environ.get("LC_MESSAGES")
        or os.environ.get("LANG")
        or ""
    )
    return "en" if value.lower().startswith("en") else "es"


UI_LANG = interface_language()

