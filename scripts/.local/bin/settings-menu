#!/usr/bin/env bash
CFG="$HOME/dotfiles/rofi/.config/rofi/config.rasi"
A="$HOME/.local/bin/appearance"

R()     { rofi -dmenu -i -no-custom -format i -config "$CFG" "$@"; }
term()  { kitty --title "Ajustes" -e bash -c "$1; echo; read -rp 'Pulsa Enter para cerrar '"; }
onoff() { [ "$($A get "$1" "$2")" = on ] && echo "Activado" || echo "Desactivado"; }
toggle(){ [ "$($A get "$1" "$2")" = on ] && $A set "$1" off || $A set "$1" on; }
sddm_mode() {
  local m; m=$(grep -m1 '^mode=' /usr/share/sddm/themes/glass/theme.conf 2>/dev/null | cut -d= -f2)
  echo "${m:-dark}"
}

# Elegir fondo: "desktop", una imagen del pack u otra imagen
pick_bg() {
  "$HOME/.local/bin/wallpaper-pick" --desktop --custom --prompt "$1"
}

while true; do
  items=( "Fondo de escritorio"
          "Avatar de perfil"
          "Fondo de la pantalla de bloqueo"
          "Fondo del inicio de sesión"
          "Desenfoque del bloqueo: $(onoff lock_blur off)"
          "Desenfoque del inicio de sesión: $(onoff sddm_blur on)"
          "Barra y dock"
          "Aplicaciones del dock"
          "Modo bajo consumo: $(onoff low_end off)" )
  idx=$(printf '%s\n' "${items[@]}" | R -p "Ajustes" -theme-str 'listview { lines: 9; }') || exit 0
  case "$idx" in
    0) "$HOME/.local/bin/wallpaper-select" ;;
    1) term "$HOME/.local/bin/avatar-select" ;;
    2) v=$(pick_bg "Fondo de bloqueo") && [ -n "$v" ] && $A set lock_bg "$v" ;;
    3) v=$(pick_bg "Fondo del login") && [ -n "$v" ] && {
         $A set sddm_bg "$v"; term "$HOME/.local/bin/sddm-install $(sddm_mode)"; } ;;
    4) toggle lock_blur off ;;
    5) toggle sddm_blur on; term "$HOME/.local/bin/sddm-install $(sddm_mode)" ;;
    6) "$HOME/.local/bin/waybar-settings" ;;
    7) "$HOME/.local/bin/dock-settings" ;;
    8) "$HOME/.local/bin/low-end-toggle" toggle ;;
  esac
done
