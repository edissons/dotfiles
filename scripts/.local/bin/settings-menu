    def wallpaper_dir_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text_box.set_hexpand(True)
        title = Gtk.Label(label=tr("Carpeta de fondos"), xalign=0)
        title.set_ellipsize(Pango.EllipsizeMode.END)
        self.wallpaper_dir_label = Gtk.Label(xalign=0)
        self.wallpaper_dir_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        self.wallpaper_dir_label.get_style_context().add_class("section-title")
        self.wallpaper_dir_label.set_max_width_chars(28)
        self.update_wallpaper_dir_label()
        text_box.pack_start(title, False, False, 0)
        text_box.pack_start(self.wallpaper_dir_label, False, False, 0)
        row.pack_start(text_box, True, True, 0)

        chevron = Gtk.Label(label="›")
        chevron.get_style_context().add_class("row-chevron")
        chevron.set_valign(Gtk.Align.CENTER)
        row.pack_start(chevron, False, False, 0)
        return self.make_clickable_row(row, self.on_change_wallpaper_dir)

    def update_wallpaper_dir_label(self):
        current = appearance_get("wallpaper_dir", str(HOME / "Pictures/wallpapers"))
        self.wallpaper_dir_label.set_text(current)
        self.wallpaper_dir_label.set_tooltip_text(current)

    def on_change_wallpaper_dir(self, *_args):
        if self.loading:
            return
        dialog = Gtk.FileChooserDialog(
            title=tr("Carpeta de fondos"),
            parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN,
            Gtk.ResponseType.OK,
        )
        current = appearance_get("wallpaper_dir", str(HOME / "Pictures/wallpapers"))
        try:
            dialog.set_current_folder(str(Path(current).expanduser()))
        except Exception:
            pass
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            chosen = dialog.get_filename()
            if chosen:
                appearance_set("wallpaper_dir", chosen)
                self.update_wallpaper_dir_label()
                run_bg([str(HOME / ".local/bin/wallpaper-select"), "restore"])
        dialog.destroy()

    def carousel_row(self):
        row, switch = self.switch_row(tr("Carrusel de fondos"))
        switch.set_active(appearance_get("wallpaper_carousel", "off") == "on")
        switch.connect("notify::active", self.on_carousel_toggled)
        return row

    def on_carousel_toggled(self, switch, _pspec):
        if self.loading:
            return
        cmd = "start" if switch.get_active() else "stop"
        run_bg([str(HOME / ".local/bin/wallpaper-carousel"), cmd])

    def carousel_interval_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")
        label = Gtk.Label(label=tr("Intervalo del carrusel"), xalign=0)
        label.set_hexpand(True)
        row.pack_start(label, True, True, 0)

        combo = Gtk.ComboBoxText()
        for value in INTERVALS:
            combo.append(value, f"{value} min")
        current = appearance_get("wallpaper_carousel_interval", "10")
        if current not in INTERVALS:
            current = "10"
        combo.set_active_id(current)
        combo.connect("changed", self.on_interval_changed)
        row.pack_start(combo, False, False, 0)
        return row

    def on_interval_changed(self, combo):
        if self.loading:
            return
        value = combo.get_active_id()
        if not value:
            return
        # Usa set-interval para guardar y reiniciar el servicio (si está activo)
        # sin forzar un cambio inmediato de fondo.
        run_bg([str(HOME / ".local/bin/wallpaper-carousel"), "set-interval", value])

