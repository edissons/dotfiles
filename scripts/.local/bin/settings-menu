    # --- IDIOMA Y ENTRADA ---
    def language_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text_box.set_hexpand(True)
        title = Gtk.Label(label=tr("Idioma del sistema"), xalign=0)
        self.language_current_label = Gtk.Label(xalign=0)
        self.language_current_label.get_style_context().add_class("row-subtitle")
        self.language_current_label.set_text(
            tr("Idioma actual: {}").format(self.current_locale or "—")
        )
        text_box.pack_start(title, False, False, 0)
        text_box.pack_start(self.language_current_label, False, False, 0)
        row.pack_start(text_box, True, True, 0)

        self.language_combo = Gtk.ComboBoxText()
        self.language_combo_handler = self.language_combo.connect(
            "changed", self.on_language_changed
        )
        self.refresh_language_combo()
        row.pack_start(self.language_combo, False, False, 0)
        return row

    def refresh_language_combo(self):
        if not hasattr(self, "language_combo"):
            return
        if getattr(self, "language_combo_handler", None):
            self.language_combo.handler_block(self.language_combo_handler)
        try:
            self.language_combo.remove_all()
            for locale in self.locales:
                self.language_combo.append(locale, locale_name(locale))
            if self.current_locale in self.locales:
                self.language_combo.set_active_id(self.current_locale)
            elif self.locales:
                self.language_combo.set_active_id(self.locales[0])
        finally:
            if getattr(self, "language_combo_handler", None):
                self.language_combo.handler_unblock(self.language_combo_handler)

    def add_language_row(self):
        row, _label, _chevron = self.action_row(tr("Añadir idioma…"))
        return self.make_clickable_row(row, self.open_add_language_dialog)

    def on_logout_now(self, _button=None):
        # Misma acción que power-menu: nunca cerrar sesión automáticamente.
        # Hyprland 0.57+ (Lua config) rechaza `hyprctl dispatch exit`, así que se
        # prueba la forma nueva y se cae a loginctl en otros casos/versiones.
        logout_cmd = (
            'hyprctl dispatch exit 2>/dev/null'
            ' || hyprctl dispatch "hl.dsp.exit()" 2>/dev/null'
            ' || loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null'
            ' || loginctl kill-session "${XDG_SESSION_ID:-}"'
        )
        if DRY_RUN:
            print(f"[dry-run] {logout_cmd}")
            self.notify(tr("Cerrar sesión ahora"), logout_cmd)
            return
        run_bg(["sh", "-c", logout_cmd])

    def notify(self, title, body="", urgency="normal"):
        # Show feedback as a desktop notification instead of inline status rows.
        if DRY_RUN:
            print(f"[notify:{urgency}] {title}: {body}")
            return
        try:
            cmd = ["notify-send", "-a", tr("Ajustes"), "-u", urgency, title]
            if body:
                cmd.append(body)
            subprocess.Popen(
                cmd,
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            print(f"settings-menu: {title}: {body}", file=sys.stderr)

    def set_language_status(self, text, spinner=False, error=False):
        # Progress states are transient; only surface results/errors as notifications.
        if spinner:
            return
        urgency = "critical" if error else "normal"
        self.notify(tr("Idioma del sistema"), text, urgency=urgency)

    def helper_error(self, rc, out, err):
        text = (err or out or "").strip()
        lines = [line for line in text.splitlines() if line.strip()]
        if lines:
            return lines[-1]
        if rc in (126, 127):
            return tr("Sin permiso o error del helper.")
        return f"rc={rc}"

    def open_add_language_dialog(self):
        entries = []
        installed = generated_locales()
        for locale, charset in supported_locale_entries():
            subtitle = charset
            if normalize_locale(locale) in installed:
                subtitle += " · " + tr("ya instalado")
            entries.append((locale, locale, subtitle))
        if not entries:
            self.set_language_status(
                tr("No se pudo leer {}.").format(SUPPORTED_LOCALES), error=True
            )
            return
        self.open_search_dialog(
            tr("Añadir idioma"),
            tr("Buscar idioma…"),
            entries,
            self.add_language,
        )

    def add_language(self, locale):
        if self.lang_applying:
            return
        self.lang_applying = True
        self.set_language_status(tr("Generando {}…").format(locale), spinner=True)

        def done(rc, out, err):
            self.lang_applying = False
            if rc == 0:
                self.locales = sorted(set(self.locales) | {normalize_locale(locale)})
                self.refresh_language_combo()
                self.set_language_status(
                    tr("Idioma {} añadido. Ya puedes seleccionarlo.").format(locale)
                )
                self.offer_language_packs(locale)
            else:
                self.set_language_status(
                    tr("Error al añadir {}: {}").format(
                        locale, self.helper_error(rc, out, err)
                    ),
                    error=True,
                )

        run_helper_async(
            ["locale-add", locale], done, dry_run=DRY_RUN, timeout=600
        )

    def on_language_changed(self, combo):
        if self.loading or self.lang_applying:
            return
        locale = combo.get_active_id()
        if not locale or locale == self.current_locale:
            return
        if normalize_locale(locale) not in generated_locales():
            self.set_language_status(
                tr("Este locale no está generado. Añádelo con «Añadir idioma…»."),
                error=True,
            )
            self.refresh_language_combo()
            return

        self.lang_applying = True
        self.set_language_status(tr("Aplicando {}…").format(locale), spinner=True)

        def done(rc, out, err):
            self.lang_applying = False
            if rc == 0:
                self.current_locale = normalize_locale(locale)
                self.language_current_label.set_text(
                    tr("Idioma actual: {}").format(self.current_locale)
                )
                self.set_language_status(
                    tr("Idioma aplicado. Cierra sesión para que las aplicaciones lo usen.")
                )
            else:
                self.set_language_status(
                    tr("Error al aplicar {}: {}").format(
                        locale, self.helper_error(rc, out, err)
                    ),
                    error=True,
                )
                self.refresh_language_combo()

        run_helper_async(["locale-set", locale], done, dry_run=DRY_RUN)

    def offer_language_packs(self, locale):
        packages = candidate_packages(locale)
        if not packages:
            self.set_language_status(
                tr("No hay paquetes de idioma disponibles para {}.").format(locale)
            )
            return

        dialog = Gtk.Dialog(
            title=tr("Paquetes de idioma"), parent=self, modal=True
        )
        dialog.set_default_size(420, 320)
        dialog.add_button(tr("Ahora no"), Gtk.ResponseType.CANCEL)
        dialog.add_button(
            tr("Instalar paquetes seleccionados"), Gtk.ResponseType.OK
        )
        content = dialog.get_content_area()
        content.set_spacing(8)
        content.set_border_width(14)
        checks = {}
        for package in packages:
            check = Gtk.CheckButton(label=package)
            checks[package] = check
            content.pack_start(check, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        selected = [
            package for package, check in checks.items() if check.get_active()
        ]
        dialog.destroy()
        if response == Gtk.ResponseType.OK and selected:
            self.install_language_packages(selected)

    def install_language_packages(self, packages):
        self.set_language_status(tr("Instalando paquetes…"), spinner=True)

        def done(rc, out, err):
            if rc == 0:
                self.set_language_status(tr("Paquetes instalados."))
            else:
                self.set_language_status(
                    tr("Error al instalar paquetes: {}").format(
                        self.helper_error(rc, out, err)
                    ),
                    error=True,
                )

        run_helper_async(
            ["pkg-install", *packages], done, dry_run=DRY_RUN, timeout=1800
        )

    def open_search_dialog(self, title, placeholder, entries, on_pick):
        dialog = Gtk.Dialog(title=title, parent=self, modal=True)
        dialog.set_default_size(460, 520)
        dialog.add_button(tr("Cancelar"), Gtk.ResponseType.CANCEL)
        dialog.add_button(tr("Añadir"), Gtk.ResponseType.OK)
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_border_width(14)

        search = Gtk.SearchEntry()
        search.set_placeholder_text(placeholder)
        search.get_style_context().add_class("settings-entry")
        content.pack_start(search, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_shadow_type(Gtk.ShadowType.NONE)
        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        listbox.get_style_context().add_class("lang-list")
        scroller.add(listbox)
        content.pack_start(scroller, True, True, 0)

        row_map = {}
        rows = []
        for item_id, text, subtitle in entries:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.set_border_width(8)
            label = Gtk.Label(label=text, xalign=0)
            box.pack_start(label, False, False, 0)
            if subtitle:
                sub = Gtk.Label(label=subtitle, xalign=0)
                sub.get_style_context().add_class("row-subtitle")
                box.pack_start(sub, False, False, 0)
            row.add(box)
            row_map[row] = item_id
            row.search_text = f"{text} {subtitle or ''}".lower()
            listbox.add(row)
            rows.append(row)

        def filter_rows(entry):
            needle = entry.get_text().strip().lower()
            for row in rows:
                row.set_visible(not needle or needle in row.search_text)

        def activate_row(_listbox, row):
            dialog.response(Gtk.ResponseType.OK)

        search.connect("search-changed", filter_rows)
        listbox.connect("row-activated", activate_row)
        dialog.show_all()
        response = dialog.run()
        selected = None
        if response == Gtk.ResponseType.OK:
            row = listbox.get_selected_row()
            if row is not None:
                selected = row_map.get(row)
        dialog.destroy()
        if selected:
            on_pick(selected)

    def keyboard_header_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")
        label = Gtk.Label(label=tr("Distribuciones de teclado"), xalign=0)
        label.set_hexpand(True)
        row.pack_start(label, True, True, 0)
        button = Gtk.Button(label=tr("Añadir distribución…"))
        button.get_style_context().add_class("action-button")
        button.connect("clicked", self.open_add_layout_dialog)
        row.pack_start(button, False, False, 0)
        return row

    def layouts_box(self):
        self.layouts_container = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8
        )
        self.render_layouts()
        return self.layouts_container

    def render_layouts(self):
        if not hasattr(self, "layouts_container"):
            return
        for child in self.layouts_container.get_children():
            self.layouts_container.remove(child)
        if not self.layouts:
            label = Gtk.Label(label=tr("No hay distribuciones activas."), xalign=0)
            label.get_style_context().add_class("error-text")
            self.layouts_container.pack_start(label, False, False, 0)
            self.layouts_container.show_all()
            return

        self.active_layout_index = max(
            0, min(self.active_layout_index, len(self.layouts) - 1)
        )
        for index, code in enumerate(self.layouts):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.get_style_context().add_class("setting-row")

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            text_box.set_hexpand(True)
            name = Gtk.Label(label=code, xalign=0)
            name.get_style_context().add_class("layout-name")
            description = Gtk.Label(
                label=self.evdev_layouts.get(code, code), xalign=0
            )
            description.get_style_context().add_class("row-subtitle")
            text_box.pack_start(name, False, False, 0)
            text_box.pack_start(description, False, False, 0)
            row.pack_start(text_box, True, True, 0)

            if index == self.active_layout_index:
                badge = Gtk.Label(label=tr("Actual"))
                badge.get_style_context().add_class("layout-badge")
                row.pack_start(badge, False, False, 0)

            up = self.small_button(
                "↑", tr("Subir"), lambda i=index: self.move_layout(i, -1), index > 0
            )
            down = self.small_button(
                "↓",
                tr("Bajar"),
                lambda i=index: self.move_layout(i, 1),
                index < len(self.layouts) - 1,
            )
            remove = self.small_button(
                "−",
                tr("Eliminar"),
                lambda i=index: self.remove_layout(i),
                len(self.layouts) > 1,
            )
            row.pack_start(up, False, False, 0)
            row.pack_start(down, False, False, 0)
            row.pack_start(remove, False, False, 0)
            self.layouts_container.pack_start(row, False, False, 0)
        self.layouts_container.show_all()

    def small_button(self, label, tooltip, callback, sensitive=True):
        button = Gtk.Button(label=label)
        button.get_style_context().add_class("action-button")
        button.set_tooltip_text(tooltip)
        button.set_sensitive(sensitive)
        button.connect("clicked", lambda _button: callback())
        return button

    def move_layout(self, index, delta):
        target = index + delta
        if target < 0 or target >= len(self.layouts):
            return
        self.layouts[index], self.layouts[target] = (
            self.layouts[target],
            self.layouts[index],
        )
        self.active_layout_index = target
        self.apply_keyboard()

    def remove_layout(self, index):
        if len(self.layouts) <= 1:
            self.set_keyboard_status(
                tr("Al menos una distribución debe permanecer."), error=True
            )
            return
        self.layouts.pop(index)
        self.active_layout_index = 0
        self.apply_keyboard()

    def add_layout(self, code):
        if code in self.layouts:
            self.set_keyboard_status(
                tr("La distribución {} ya está en la lista.").format(code)
            )
            return
        self.layouts.append(code)
        self.apply_keyboard()

    def open_add_layout_dialog(self):
        if not self.evdev_layouts:
            self.set_keyboard_status(
                tr("No se encontró {}; instala el paquete {}.").format(
                    EVDEV_LST, "xkeyboard-config"
                ),
                error=True,
            )
            return
        entries = [
            (code, code, description)
            for code, description in sorted(self.evdev_layouts.items())
        ]
        self.open_search_dialog(
            tr("Añadir distribución"),
            tr("Buscar distribución…"),
            entries,
            self.add_layout,
        )

    def layout_toggle_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")
        label = Gtk.Label(label=tr("Atajo para cambiar"), xalign=0)
        label.set_hexpand(True)
        row.pack_start(label, True, True, 0)

        self.toggle_combo = Gtk.ComboBoxText()
        choices = [
            ("", tr("Ninguno")),
            ("grp:alt_shift_toggle", "Alt + Shift"),
            ("grp:win_space_toggle", "Super + Space"),
            ("grp:caps_toggle", "Caps Lock"),
        ]
        for value, text in choices:
            self.toggle_combo.append(value, text)
        current = self.kb_options[0] if self.kb_options else ""
        if current and current not in {value for value, _ in choices}:
            self.toggle_combo.append(current, current)
        self.toggle_combo.set_active_id(current)
        self.toggle_combo.connect("changed", self.on_toggle_changed)
        row.pack_start(self.toggle_combo, False, False, 0)
        return row

    def on_toggle_changed(self, combo):
        if self.loading:
            return
        value = combo.get_active_id() or ""
        self.kb_options = [value] if value else []
        self.apply_keyboard()

    def keyboard_test_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")
        label = Gtk.Label(label=tr("Probar teclado"), xalign=0)
        label.set_hexpand(True)
        row.pack_start(label, True, True, 0)
        entry = Gtk.Entry()
        entry.set_placeholder_text(tr("Escribe aquí…"))
        entry.set_width_chars(18)
        entry.get_style_context().add_class("settings-entry")
        row.pack_start(entry, False, False, 0)
        return row

    def set_keyboard_status(self, text, spinner=False, error=False):
        # Progress states are transient; only surface results/errors as notifications.
        if spinner:
            return
        urgency = "critical" if error else "normal"
        self.notify(tr("Distribuciones de teclado"), text, urgency=urgency)

    def apply_keyboard(self):
        if self.kb_applying:
            # Queue the latest requested state so rapid edits (add/move/toggle)
            # are not dropped while the helper is running.
            self.kb_pending = True
            return
        if not self.layouts:
            self.set_keyboard_status(tr("No hay distribuciones activas."), error=True)
            return

        self.kb_applying = True
        self.kb_pending = False
        self.set_keyboard_status(tr("Aplicando teclado…"), spinner=True)

        # Snapshot the state being applied so async callbacks report/apply the
        # same layouts/options even if the user changes them again.
        layouts = list(self.layouts)
        options = list(self.kb_options)

        if DRY_RUN:
            print(
                "[dry-run] hyprctl eval hl.config({ input = { kb_layout = \""
                + ",".join(layouts)
                + "\", kb_options = \""
                + ",".join(options)
                + "\" } })"
            )
            write_language_input_block(layouts, options)
        else:
            ok, error = hypr_apply_keyboard(layouts, options)
            # Persist the user's own marked block regardless of the helper
            # result: Hyprland live state and userprefs are the user's config.
            write_language_input_block(layouts, options)
            if ok:
                self.active_layout_index = hypr_active_layout_index()
                self.render_layouts()
                self.set_keyboard_status(
                    tr("Distribuciones aplicadas: {}").format(",".join(layouts))
                )
            else:
                self.set_keyboard_status(
                    tr("Error al aplicar el teclado: {}").format(error), error=True
                )

        def done(rc, out, err):
            self.kb_applying = False
            if rc != 0:
                self.set_keyboard_status(
                    tr("Error al aplicar el teclado: {}").format(
                        self.helper_error(rc, out, err)
                    ),
                    error=True,
                )
            elif not DRY_RUN:
                self.set_keyboard_status(
                    tr("Distribuciones aplicadas: {}").format(",".join(layouts))
                )
            if self.kb_pending:
                self.apply_keyboard()

        run_helper_async(
            ["keymap-set", ",".join(layouts), ",".join(options)],
            done,
            dry_run=DRY_RUN,
        )

    # --- SISTEMA Y PERFIL ---
    def avatar_row(self):
        row, _label, _chevron = self.action_row(tr("Avatar de perfil"))
        return self.make_clickable_row(
            row, lambda: run_term(str(HOME / ".local/bin/avatar-select"))
        )

    def low_end_row(self):
        row, switch = self.switch_row(tr("Modo bajo consumo"))
        switch.set_active(appearance_get("low_end", "off") == "on")
        switch.connect("notify::active", self.on_low_end_toggled)
        return row

    def on_low_end_toggled(self, _switch, _pspec):
        if self.loading:
            return
        run_bg([str(HOME / ".local/bin/low-end-toggle"), "toggle"])

    def on_destroy(self, _window):
        pass


class SettingsApp(Gtk.Application):
    """Single-instance app: launching again while open toggles (closes) it."""

    def __init__(self):
        super().__init__(application_id="glasshouse.settingsmenu")
        self.win = None

    def do_activate(self):
        # Toggle: if a window is already open, close it.
        if self.win and self.win.get_visible():
            self.win.destroy()
            self.win = None
            return
        self.win = SettingsPanel(self)
        self.win.show_all()


def main():
    load_css(THEME_CSS, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    load_css(SETTINGS_CSS, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
    app = SettingsApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
