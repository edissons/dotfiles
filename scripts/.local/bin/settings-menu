def tr(text):
    return STRINGS_EN.get(text, text) if UI_LANG == "en" else text



def appearance_get(key, default):
    try:
        out = subprocess.check_output(
            [str(APPEARANCE), "get", key, default],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        return out.strip() or default
    except (OSError, subprocess.SubprocessError):
        return default


def appearance_set(key, value):
    try:
        subprocess.run(
            [str(APPEARANCE), "set", key, str(value)],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def run_bg(cmd):
    try:
        subprocess.Popen(
            cmd,
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def run_term(command_str):
    try:
        subprocess.Popen(
            [
                "kitty",
                "--title",
                tr("Ajustes"),
                "-e",
                "bash",
                "-c",
                command_str + '; echo; read -rp "' + tr("Pulsa Enter para cerrar ") + '"',
            ],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def sddm_mode():
    try:
        for line in SDDM_THEME_CONF.read_text(encoding="utf-8").splitlines():
            if line.startswith("mode="):
                value = line.split("=", 1)[1].strip()
                return value or "dark"
    except (OSError, ValueError):
        pass
    return "dark"


def sddm_install_term(value=None):
    mode = sddm_mode()
    target = value if value is not None else mode
    run_term(f"{HOME / '.local/bin/sddm-install'} {target}")


# ---------------------------------------------------------------------------
# Language & Input helpers
# ---------------------------------------------------------------------------

def helper_path():
    if LOCALE_HELPER_INSTALLED.is_file():
        return str(LOCALE_HELPER_INSTALLED)
    if LOCALE_HELPER_REPO.is_file():
        return str(LOCALE_HELPER_REPO)
    return None


def run_helper(args, dry_run=False, timeout=300):
    """Call the privileged helper as the user, never as root.

    Order: pkexec (polkit rule, no prompt for wheel), sudo -n (optional
    NOPASSWD drop-in), then direct (works for --status/--dry-run and for a
    developer running the repo helper manually).
    """
    hp = helper_path()
    if not hp:
        return 127, "", tr("El helper no está instalado. Ejecuta install.sh con --with-localeinput.")
    cmd = [hp, *args]
    if dry_run:
        cmd.append("--dry-run")
        # Dry-run never needs root: run the helper directly so the UI can be
        # tested without a polkit prompt or an authentication agent.
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            return result.returncode, result.stdout or "", result.stderr or ""
        except (OSError, subprocess.SubprocessError) as exc:
            return 1, "", str(exc)
    last = (1, "", "")
    for prefix in (["pkexec"], ["sudo", "-n"], []):
        if prefix and not shutil.which(prefix[0]):
            continue
        try:
            result = subprocess.run(
                prefix + cmd, capture_output=True, text=True, timeout=timeout
            )
            last = (result.returncode, result.stdout or "", result.stderr or "")
            if prefix and result.returncode in (126, 127):
                continue
            return last
        except (OSError, subprocess.SubprocessError) as exc:
            last = (1, "", str(exc))
    return last


def run_helper_async(args, callback, dry_run=False, timeout=300):
    """Run the helper off the GTK thread and deliver the result via idle_add."""
    def worker():
        result = run_helper(args, dry_run=dry_run, timeout=timeout)
        GLib.idle_add(callback, *result)

    threading.Thread(target=worker, daemon=True).start()


def read_localectl():
    try:
        out = subprocess.check_output(
            ["localectl", "status"], text=True, stderr=subprocess.DEVNULL, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    data = {}
    for line in out.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            data[key.strip()] = value.strip()
    return data


def normalize_locale(locale):
    value = (locale or "").strip()
    return re.sub(r"\.utf-?8$", ".UTF-8", value, flags=re.IGNORECASE)


def generated_locales():
    try:
        out = subprocess.check_output(
            ["locale", "-a"], text=True, stderr=subprocess.DEVNULL, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return set()
    result = set()
    for line in out.splitlines():
        value = normalize_locale(line)
        if value and value not in ("C", "POSIX", "C.UTF-8"):
            result.add(value)
    return result


def current_system_locale():
    status = read_localectl()
    value = status.get("System Locale", "")
    match = re.search(r"LANG=([^\s]+)", value)
    return normalize_locale(match.group(1)) if match else ""


def locale_name(locale):
    names = {
        "en_US.UTF-8": "English (US)",
        "en_GB.UTF-8": "English (UK)",
        "es_CO.UTF-8": "Español (Colombia)",
        "es_MX.UTF-8": "Español (México)",
        "es_ES.UTF-8": "Español (España)",
        "es_AR.UTF-8": "Español (Argentina)",
        "es_CL.UTF-8": "Español (Chile)",
    }
    name = names.get(locale)
    return f"{locale} — {name}" if name else locale


def supported_locale_entries():
    try:
        lines = SUPPORTED_LOCALES.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    entries = []
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 2:
            entries.append((parts[0], parts[1]))
    return entries


def parse_evdev():
    """Read the ! layout and ! option sections of evdev.lst.

    The first occurrence of a code is the canonical description; later ones are
    aliases such as "us  ba: Bosnian (US)".
    """
    try:
        text = EVDEV_LST.read_text(encoding="utf-8")
    except OSError:
        return {}, {}
    layouts, options = {}, {}
    section = None
    for raw in text.splitlines():
        line = raw.rstrip()
        if line.startswith("!"):
            section = line[1:].strip()
            continue
        if section not in ("layout", "option") or not line.startswith("  "):
            continue
        parts = line.strip().split(None, 1)
        if not parts:
            continue
        code = parts[0]
        desc = parts[1] if len(parts) > 1 else code
        if section == "layout":
            layouts.setdefault(code, desc)
        else:
            options.setdefault(code, desc)
    return layouts, options


def package_exists(package):
    if not shutil.which("pacman"):
        return False
    try:
        result = subprocess.run(
            ["pacman", "-Si", package],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=20,
        )
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def candidate_packages(locale):
    """Real language-pack candidates for a locale, filtered by pacman -Si."""
    base = locale.split(".", 1)[0]
    lang, _, territory = base.partition("_")
    territory = territory.lower()
    candidates = []
    if lang == "es":
        if territory:
            candidates.append(f"hunspell-es_{territory}")
        candidates.extend(
            [
                "hunspell-es_any",
                "mythes-es",
                "hyphen-es",
                f"firefox-i18n-es-{territory or 'es'}",
                "firefox-i18n-es-es",
                "thunderbird-i18n-es-es",
                "libreoffice-still-es",
            ]
        )
    elif lang == "en":
        if territory:
            candidates.append(f"hunspell-en_{territory}")
        candidates.extend(
            [
                "hunspell-en_us",
                "mythes-en",
                "hyphen-en",
                "libreoffice-still-en-us",
            ]
        )
    else:
        candidates.extend(
            [
                f"hunspell-{lang}",
                f"mythes-{lang}",
                f"hyphen-{lang}",
                f"firefox-i18n-{lang}",
                f"libreoffice-still-{lang}",
            ]
        )
    result, seen = [], set()
    for package in candidates:
        if package in seen:
            continue
        seen.add(package)
        if package_exists(package):
            result.append(package)
    return result


def replace_marked_block(text, begin, end, block):
    """Remove every existing marked block and append exactly one new block."""
    lines = text.splitlines()
    kept, skipping = [], False
    for line in lines:
        if line.strip() == begin:
            skipping = True
            continue
        if skipping:
            if line.strip() == end:
                skipping = False
            continue
        kept.append(line)
    while kept and not kept[-1].strip():
        kept.pop()
    if kept:
        kept.append("")
    kept.extend(block.splitlines())
    return "\n".join(kept).rstrip("\n") + "\n"


def write_language_input_block(layouts, options):
    """Persist the live layout in the user's own marked block.

    Both files are written because HyDE can be running either the legacy .conf
    or the Lua provider.  Only the marked block is replaced; the rest of the
    file is left byte-for-byte intact.
    """
    layout_str = ",".join(layouts)
    options_str = ",".join(options)
    conf_block = "\n".join(
        [
            "# >>> language-input >>>",
            "# Managed by Settings -> Language & Input (Glasshouse).",
            "# This block is replaced on every change; do not edit it by hand.",
            "input {",
            f"    kb_layout = {layout_str}",
            f"    kb_options = {options_str}".rstrip(),
            "}",
            "# <<< language-input <<<",
        ]
    )
    lua_block = "\n".join(
        [
            "-- >>> language-input >>>",
            "-- Managed by Settings -> Language & Input (Glasshouse).",
            "-- This block is replaced on every change; do not edit it by hand.",
            "hl.config({",
            "    input = {",
            f'        kb_layout = "{layout_str}",',
            f'        kb_options = "{options_str}",',
            "    },",
            "})",
            "-- <<< language-input <<<",
        ]
    )
    written = []
    for path, begin, end, block in (
        (USERPREFS_CONF, "# >>> language-input >>>", "# <<< language-input <<<", conf_block),
        (USERPREFS_LUA, "-- >>> language-input >>>", "-- <<< language-input <<<", lua_block),
    ):
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
            updated = replace_marked_block(text, begin, end, block)
            if DRY_RUN:
                print(f"[dry-run] write {path}:\n{block}")
            else:
                path.write_text(updated, encoding="utf-8")
            written.append(path)
        except OSError as exc:
            print(f"settings-menu: cannot write {path}: {exc}", file=sys.stderr)
    return written


def hypr_getoption(name):
    try:
        out = subprocess.check_output(
            ["hyprctl", "getoption", name],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    for line in out.splitlines():
        if line.startswith("str:"):
            value = line.split(":", 1)[1].strip()
            return "" if value == "[[EMPTY]]" else value
    return ""


def hypr_active_layout_index():
    try:
        out = subprocess.check_output(
            ["hyprctl", "-j", "devices"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        import json

        data = json.loads(out)
        for keyboard in data.get("keyboards", []):
            if keyboard.get("main"):
                return int(keyboard.get("active_layout_index", 0))
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        pass
    return 0


def read_hypr_keyboard():
    layouts = [
        item.strip()
        for item in hypr_getoption("input:kb_layout").split(",")
        if item.strip()
    ]
    options = [
        item.strip()
        for item in hypr_getoption("input:kb_options").split(",")
        if item.strip()
    ]
    if not layouts:
        layouts = ["us"]
    return layouts, options, hypr_active_layout_index()


def hypr_apply_keyboard(layouts, options):
    """Apply the layout live.

    Hyprland 0.57 (Lua config provider) rejects `hyprctl keyword` with
    "unknown request"; `hyprctl eval` with hl.config() works.  Older hyprlang
    versions use `hyprctl keyword`, so both are tried.
    """
    if not shutil.which("hyprctl"):
        return False, tr("hyprctl no está disponible.")
    layout_str = ",".join(layouts)
    options_str = ",".join(options)
    code = (
        'hl.config({ input = { kb_layout = "'
        + layout_str
        + '", kb_options = "'
        + options_str
        + '" } })'
    )
    try:
        result = subprocess.run(
            ["hyprctl", "eval", code], capture_output=True, text=True, timeout=10
        )
        output = ((result.stdout or "") + (result.stderr or "")).strip()
        lowered = output.lower()
        if result.returncode == 0 and "error" not in lowered and "unknown request" not in lowered:
            return True, ""
    except (OSError, subprocess.SubprocessError):
        pass

    # Fallback for hyprlang-based versions.
    last_error = ""
    for key, value in (("input:kb_layout", layout_str), ("input:kb_options", options_str)):
        try:
            result = subprocess.run(
                ["hyprctl", "keyword", key, value],
                capture_output=True,
                text=True,
                timeout=10,
            )
            output = ((result.stdout or "") + (result.stderr or "")).strip()
            last_error = output
            if result.returncode != 0 or "unknown request" in output.lower() or output.lower().startswith("error"):
                return False, output or tr("No se pudo verificar el layout activo con hyprctl.")
        except (OSError, subprocess.SubprocessError) as exc:
            return False, str(exc)
    return True, last_error


def load_css(path, priority):
    if not path.is_file():
        print(f"settings-menu: CSS not found: {path}", file=sys.stderr)
        return None
    provider = Gtk.CssProvider()
    provider.connect(
        "parsing-error",
        lambda _p, section, error: print(
            f"settings-menu: CSS error in {path}:{section.get_start_line() + 1}: {error.message}",
            file=sys.stderr,
        ),
    )
    try:
        provider.load_from_path(str(path))
    except GLib.Error as exc:
        print(f"settings-menu: cannot load {path}: {exc.message}", file=sys.stderr)
        return None
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(screen, provider, priority)
    return provider


class SettingsPanel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr("Ajustes"))
        self.set_default_size(520, 780)
        self.get_style_context().add_class("settings-window")

        self.loading = True
        self.lang_applying = False
        self.kb_applying = False
        self.kb_pending = False
        self.current_locale = current_system_locale()
        self.locales = sorted(generated_locales())
        if self.current_locale and self.current_locale not in self.locales:
            self.locales.append(self.current_locale)
        self.layouts, self.kb_options, self.active_layout_index = read_hypr_keyboard()
        self.evdev_layouts, self.evdev_options = parse_evdev()
        self.package_cache = {}

        self.build_chrome()
        self.populate_body()

        self.connect("destroy", self.on_destroy)
        self.loading = False

    def build_chrome(self):
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.get_style_context().add_class("settings-header")
        title = Gtk.Label(label=tr("Ajustes"))
        title.get_style_context().add_class("settings-title")
        header.set_custom_title(title)
        self.set_titlebar(header)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_shadow_type(Gtk.ShadowType.NONE)

        self.surface = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.surface.get_style_context().add_class("settings-surface")
        self.surface.set_border_width(16)
        scroller.add(self.surface)
        self.add(scroller)

    def populate_body(self):
        self.surface.pack_start(self.section_title(tr("FONDOS")), False, False, 0)
        self.surface.pack_start(self.wallpaper_row(), False, False, 0)
        self.surface.pack_start(self.wallpaper_dir_row(), False, False, 0)
        self.surface.pack_start(self.carousel_row(), False, False, 0)
        self.surface.pack_start(self.carousel_interval_row(), False, False, 0)

        self.surface.pack_start(
            self.section_title(tr("BLOQUEO E INICIO DE SESIÓN")), False, False, 0
        )
        self.surface.pack_start(self.lock_bg_row(), False, False, 0)
        self.surface.pack_start(self.sddm_bg_row(), False, False, 0)
        self.surface.pack_start(self.lock_blur_row(), False, False, 0)
        self.surface.pack_start(self.sddm_blur_row(), False, False, 0)

        self.surface.pack_start(self.section_title(tr("INTERFAZ")), False, False, 0)
        self.surface.pack_start(self.waybar_row(), False, False, 0)
        self.surface.pack_start(self.dock_apps_row(), False, False, 0)

        # --- Language & Input ---
        self.surface.pack_start(
            self.section_title(tr("IDIOMA Y ENTRADA")), False, False, 0
        )
        self.surface.pack_start(self.language_row(), False, False, 0)
        self.surface.pack_start(self.add_language_row(), False, False, 0)
        self.surface.pack_start(self.keyboard_header_row(), False, False, 0)
        self.surface.pack_start(self.layouts_box(), False, False, 0)
        self.surface.pack_start(self.layout_toggle_row(), False, False, 0)
        self.surface.pack_start(self.keyboard_test_row(), False, False, 0)

        self.surface.pack_start(
            self.section_title(tr("SISTEMA Y PERFIL")), False, False, 0
        )
        self.surface.pack_start(self.avatar_row(), False, False, 0)
        self.surface.pack_start(self.low_end_row(), False, False, 0)

    def section_title(self, text):
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("section-title")
        return label

    def action_row(self, title):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")
        label = Gtk.Label(label=title, xalign=0)
        label.set_hexpand(True)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        row.pack_start(label, True, True, 0)
        chevron = Gtk.Label(label="›")
        chevron.get_style_context().add_class("row-chevron")
        chevron.set_valign(Gtk.Align.CENTER)
        row.pack_start(chevron, False, False, 0)
        return row, label, chevron

    def make_clickable_row(self, row, activate_cb):
        row.get_style_context().add_class("clickable-row")
        event_box = Gtk.EventBox()
        event_box.set_visible_window(False)
        event_box.add_events(
            Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.ENTER_NOTIFY_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
        )
        event_box.add(row)

        def on_release(_widget, event):
            if event.button == 1:
                activate_cb()
            return False

        def on_enter(widget, _event):
            window = widget.get_window()
            if window is not None:
                display = Gdk.Display.get_default()
                try:
                    cursor = Gdk.Cursor.new_from_name(display, "pointer")
                except Exception:
                    cursor = None
                if cursor is None:
                    cursor = Gdk.Cursor.new_for_display(display, Gdk.CursorType.HAND1)
                window.set_cursor(cursor)
            return False

        def on_leave(widget, _event):
            window = widget.get_window()
            if window is not None:
                window.set_cursor(None)
            return False

        event_box.connect("button-release-event", on_release)
        event_box.connect("enter-notify-event", on_enter)
        event_box.connect("leave-notify-event", on_leave)
        return event_box

    def switch_row(self, title):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class("setting-row")
        label = Gtk.Label(label=title, xalign=0)
        label.set_hexpand(True)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        row.pack_start(label, True, True, 0)
        switch = Gtk.Switch()
        switch.set_valign(Gtk.Align.CENTER)
        row.pack_start(switch, False, False, 0)
        return row, switch

