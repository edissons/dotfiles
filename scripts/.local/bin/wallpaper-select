#!/usr/bin/env bash
DIR="$HOME/Pictures/wallpapers"
CACHE="$HOME/.cache/current-wallpaper"

apply() {
  old=$(pgrep -x swaybg)
  setsid nohup swaybg -i "$1" -m fill >/dev/null 2>&1 &
  sleep 0.4
  [ -n "$old" ] && kill $old 2>/dev/null
  echo "$1" > "$CACHE"
}

if [ "$1" = restore ]; then
  if [ -f "$CACHE" ]; then apply "$(cat "$CACHE")"; else apply "$DIR/wall.jpg"; fi
  exit 0
fi

sel=$(for f in "$DIR"/*.{jpg,jpeg,png,webp}; do
        [ -f "$f" ] && printf '%s\0icon\x1f%s\n' "$(basename "$f")" "$f"
      done | rofi -dmenu -show-icons -no-custom -i -p "Fondo" \
        -config "$HOME/dotfiles/rofi/.config/rofi/config.rasi" \
        -theme-str 'element-icon { size: 64px; } listview { lines: 5; }') || exit 0
[ -n "$sel" ] && apply "$DIR/$sel"
