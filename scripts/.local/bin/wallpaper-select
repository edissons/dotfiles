#!/usr/bin/env bash
DIR="$("$HOME/.local/bin/appearance" get wallpaper_dir "$HOME/Pictures/wallpapers")"
CACHE="$HOME/.cache/current-wallpaper"

apply() {
  old=$(pgrep -x swaybg)
  setsid nohup swaybg -i "$1" -m fill >/dev/null 2>&1 &
  sleep 0.4
  [ -n "$old" ] && kill $old 2>/dev/null
  echo "$1" > "$CACHE"
}

if [ "$1" = restore ]; then
  wp=""
  [ -f "$CACHE" ] && wp=$(cat "$CACHE")
  if [ -n "$wp" ] && [ -f "$wp" ]; then
    apply "$wp"
    exit 0
  fi
  if [ -f "$DIR/wall.jpg" ]; then
    apply "$DIR/wall.jpg"
    exit 0
  fi
  wp=$(find "$DIR" -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print -quit 2>/dev/null)
  [ -n "$wp" ] && apply "$wp"
  exit 0
fi

sel=$("$HOME/.local/bin/wallpaper-pick") || exit 0
[ -n "$sel" ] && apply "$sel"
