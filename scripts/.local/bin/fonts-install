#!/usr/bin/env bash
set -euo pipefail
SRC="${1:-$HOME/.local/share/fonts/San-Francisco-Pro-Fonts-master}"
DST="/usr/local/share/fonts/sf-pro"
[ -d "$SRC" ] || { echo "No se encontró $SRC"; exit 1; }
mapfile -t FONTS < <(find "$SRC" -maxdepth 1 -type f \( -iname '*.otf' -o -iname '*.ttf' \) -print)
[ "${#FONTS[@]}" -gt 0 ] || { echo "No hay fuentes en $SRC"; exit 1; }
sudo install -d -m 755 "$DST"
sudo install -m 644 "${FONTS[@]}" "$DST/"
sudo fc-cache -f >/dev/null
echo "Instaladas ${#FONTS[@]} fuentes en $DST"
fc-match -f 'Usuario: %{family} | %{style} | %{file}\n' "SF Pro Text"
sudo -u sddm fc-match -f 'SDDM: %{family} | %{style} | %{file}\n' "SF Pro Text" || true
