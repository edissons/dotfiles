#%PAM-1.0
# Managed by Glasshouse install.sh (--with-lockout / --with-fingerprint).
# Backup: /etc/pam.d/sddm.bak.<timestamp>

auth        required    pam_env.so
auth        required    pam_shells.so
auth        requisite   pam_nologin.so
auth        [success=ignore default=ignore] pam_exec.so quiet /usr/local/bin/glasshouse-pam-cooldown --sleep
@FINGERPRINT@
auth        required    pam_faillock.so preauth conf=/etc/security/faillock-lockscreen.conf dir=/run/faillock-lockscreen
-auth       [success=2 default=ignore] pam_systemd_home.so
auth        [success=1 default=bad] pam_unix.so try_first_pass nullok
auth        [default=die] pam_faillock.so authfail conf=/etc/security/faillock-lockscreen.conf dir=/run/faillock-lockscreen
auth        optional    pam_permit.so
auth        required    pam_faillock.so authsucc conf=/etc/security/faillock-lockscreen.conf dir=/run/faillock-lockscreen
-auth       optional    pam_gnome_keyring.so
-auth       optional    pam_kwallet5.so

account     include     system-login

password    include     system-login
-password   optional    pam_gnome_keyring.so    use_authtok

session     optional    pam_keyinit.so          force revoke
session     include     system-login
-session    optional    pam_gnome_keyring.so    auto_start
-session    optional    pam_kwallet5.so         auto_start
