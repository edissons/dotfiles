[Unit]
Description=Shutdown sound
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target poweroff.target kexec.target
After=sound.target
Conflicts=reboot.target halt.target poweroff.target kexec.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/aplay -q -D plughw:1,0 /usr/local/share/sounds/shutdown.wav
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
