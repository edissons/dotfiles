#!/usr/bin/env bash
T="$HOME/.config/theme"
cur=$(cat "$T/mode" 2>/dev/null || echo dark)

case "${1:-toggle}" in
  dark|light) mode="$1" ;;
  *) [ "$cur" = dark ] && mode=light || mode=dark ;;
esac
echo "$mode" > "$T/mode"

for f in css conf rasi kitty; do
  ln -sf "$T/$mode/colors.$f" "$T/current.$f"
done

if [ "$mode" = dark ]; then
  GTKT='WhiteSur-Dark'; ICONS='WhiteSur-glass'; SCHEME='prefer-dark'
else
  GTKT='WhiteSur-Light'; ICONS='WhiteSur-glass-light'; SCHEME='prefer-light'
fi
gsettings set org.gnome.desktop.interface color-scheme "$SCHEME"
gsettings set org.gnome.desktop.interface gtk-theme "$GTKT"
gsettings set org.gnome.desktop.interface icon-theme "$ICONS"

GTK3="$HOME/.config/gtk-3.0/settings.ini"
if [ -f "$GTK3" ]; then
  sed -i --follow-symlinks "s/^gtk-theme-name=.*/gtk-theme-name=$GTKT/" "$GTK3"
  sed -i --follow-symlinks "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICONS/" "$GTK3"
fi

setsid "$HOME/.local/bin/dock-restart" >/dev/null 2>&1 &
"$HOME/.local/bin/theme-qt" "$mode"
swaync-client -rs >/dev/null 2>&1
pkill -USR1 -x kitty 2>/dev/null
hyprctl reload
setsid sh -c "sleep 0.3; pkill -SIGUSR2 waybar" >/dev/null 2>&1 &
echo "Tema: $mode"
