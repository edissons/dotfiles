{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 8,
  "notification-window-width": 380,
  "control-center-width": 400,
  "notification-icon-size": 48,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "hide-on-clear": true,
  "hide-on-action": true,
  "widgets": ["title", "dnd", "mpris", "volume", "backlight", "notifications"],
  "widget-config": {
    "title": { "text": "Notificaciones", "clear-all-button": true, "button-text": "Borrar todo" },
    "dnd": { "text": "No molestar" },
    "mpris": { "image-size": 48, "image-radius": 12 },
    "volume": { "label": "󰕾" },
    "backlight": { "label": "󰃟" }
  }
}
