@import "/home/shadow/.config/theme/current.rasi"

configuration {
    font: "SF Pro Text 13";
    show-icons: true;
    /* Un solo clic acepta; el cursor ya selecciona al pasar por encima. */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    location: center;
    anchor: center;
    width: 780px;
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 24px;
}

mainbox {
    padding: 20px;
    spacing: 16px;
    background-color: transparent;
    children: [ "listview", "message" ];
}

message {
    background-color: transparent;
    padding: 0;
    border: 0;
}

textbox {
    background-color: transparent;
    text-color: @subtext;
    horizontal-align: 0.5;
    font: "SF Pro Text 13";
}

listview {
    columns: 6;
    lines: 1;
    fixed-columns: true;
    spacing: 12px;
    scrollbar: false;
    background-color: transparent;
}

/* Botones casi circulares (~113x105 px, radio 52) en una fila de 6. */
element {
    orientation: vertical;
    padding: 20px 8px 16px 8px;
    spacing: 8px;
    border: 2px;
    border-radius: 52px;
}

element normal.normal, element alternate.normal {
    background-color: @tile;
    text-color: @text;
    border-color: @border;
}

element selected.normal {
    background-color: @tile-selected;
    text-color: @text;
    border-color: @accent;
}

element normal.active, element alternate.active {
    background-color: @accent;
    text-color: @on-accent;
    border-color: @accent;
}

element selected.active {
    background-color: @accent;
    text-color: @on-accent;
    border-color: @text;
}

element-icon {
    size: 44px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    font: "SF Pro Text 10";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
